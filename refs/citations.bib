% Verified citations for the KRAS G12D PDAC neoantigen feasibility study.
% Every entry below has had its journal, year, volume, pages, and key claim
% verified against the publisher / PubMed / PMC record via WebSearch in Step 5.
% See refs/notes.md for the verification log and the corrections made.

@article{Rojas2023Nature,
  author       = {Rojas, Luis A. and Sethna, Zachary and Soares, Kevin C. and Olcese, Cristina and Pang, Nan and Patterson, Erin and Lihm, Jayon and Ceglia, Nicholas and Guasp, Pablo and Chu, Alexander and Yu, Rebecca and Chandra, Akihiro Ko and Waters, Theresa and Ruan, Jennifer and Amisaki, Masataka and Zebboudj, Abderezak and Odgerel, Zagaa and Payne, George and Derhovanessian, Evelyna and Mueller, Felicitas and Rhee, Ina and Yadav, Mahesh and Dobrin, Anton and Sadelain, Michel and {\L}uksza, Marta and Cohen, Noah and Tang, Laura and Basturk, Olca and G{\"o}nen, Mithat and Katz, Seth and Do, Richard K. and Epstein, Andrew S. and Momtaz, Parisa and Park, Wungki and Sugarman, Ryan and Varghese, Anna M. and Won, Elizabeth and Desai, Avni and Wei, Alice C. and D{'}Angelica, Michael I. and Kingham, T. Peter and Mellman, Ira and Merghoub, Taha and Wolchok, Jedd D. and Sahin, Ugur and T{\"u}reci, {\"O}zlem and Greenbaum, Benjamin D. and Jarnagin, William R. and Drebin, Jeffrey and O{'}Reilly, Eileen M. and Balachandran, Vinod P.},
  title        = {Personalized {RNA} neoantigen vaccines stimulate {T} cells in pancreatic cancer},
  journal      = {Nature},
  year         = {2023},
  volume       = {618},
  number       = {7963},
  pages        = {144--150},
  doi          = {10.1038/s41586-023-06063-y},
  pmid         = {37165196},
  url          = {https://www.nature.com/articles/s41586-023-06063-y},
  note         = {Phase 1 trial of adjuvant autogene cevumeran (BNT122) + atezolizumab + mFOLFIRINOX in 16 resected PDAC patients. 8/16 showed vaccine-induced neoantigen-specific T cells with median RFS not reached vs 13.4 mo in non-responders (P=0.003). Neoantigen selection was personalised per tumour; not specifically targeting G12D / HLA-A*11:01. Used here as the contextual rationale for an mRNA-vaccine pipeline targeting KRAS G12D.}
}

@article{Wang2016CIR,
  author       = {Wang, Qing J. and Yu, Zhiya and Griffith, Kris and Hanada, Ken-ichi and Restifo, Nicholas P. and Yang, James C.},
  title        = {Identification of {T}-cell Receptors Targeting {KRAS}-Mutated Human Tumors},
  journal      = {Cancer Immunology Research},
  year         = {2016},
  volume       = {4},
  number       = {3},
  pages        = {204--214},
  doi          = {10.1158/2326-6066.CIR-15-0188},
  pmid         = {26701267},
  url          = {https://aacrjournals.org/cancerimmunolres/article/4/3/204/468486/},
  note         = {Identified HLA-A*11:01 as a presenting MHC molecule for KRAS G12D 9-mer VVGADGVGK and 10-mer VVVGADGVGK, and the corresponding G12V epitopes. HLA-A*11:01 transgenic mice were immunised with the 10-mer G12V/G12D peptides; murine TCRs (TRAV4-4*01/BV12-2*01 for G12D) were isolated and shown to recognise A*11:01-positive KRAS-G12D pancreatic tumour lines. THIS is the canonical primary reference for the VVGADGVGK / HLA-A*11:01 connection used in this study, NOT Tran 2016 NEJM (which is HLA-C*08:02).}
}

@article{Tran2016NEJM,
  author       = {Tran, Eric and Robbins, Paul F. and Lu, Yong-Chen and Prickett, Todd D. and Gartner, Jared J. and Jia, Li and Pasetto, Anna and Zheng, Zhili and Ray, Satyajit and Groh, Eric M. and Kriley, Isaac R. and Rosenberg, Steven A.},
  title        = {{T}-Cell Transfer Therapy Targeting Mutant {KRAS} in Cancer},
  journal      = {New England Journal of Medicine},
  year         = {2016},
  volume       = {375},
  number       = {23},
  pages        = {2255--2262},
  doi          = {10.1056/NEJMoa1609279},
  pmid         = {27959684},
  url          = {https://www.nejm.org/doi/full/10.1056/NEJMoa1609279},
  note         = {Adoptive transfer of 1.11e11 HLA-C*08:02-restricted (NOT A*11:01) TIL clonotypes targeting KRAS G12D in a metastatic colorectal-cancer (NOT pancreatic) patient. All 7 lung mets regressed; one progressed at 9 mo due to chr-6 haplotype loss eliminating HLA-C*08:02. The recognised peptides were G12D 9-mer GADGVGKSA and 10-mer GADGVGKSAL, presented by HLA-C*08:02. Cited here as proof-of-concept for KRAS-G12D-directed adoptive cell therapy, NOT as the A*11:01/VVGADGVGK reference.}
}

@article{Leidner2022NEJM,
  author       = {Leidner, Rom and Sanjuan Silva, Nelson and Huang, Hong and Sprott, David and Zheng, Chunhong and Shih, Yi-Ping and Leung, Amy and Payne, Reid and Sutcliffe, Kim and Cramer, Julie and Rosenberg, Steven A. and Fox, Bernard A. and Urba, Walter J. and Tran, Eric},
  title        = {Neoantigen {T}-Cell Receptor Gene Therapy in Pancreatic Cancer},
  journal      = {New England Journal of Medicine},
  year         = {2022},
  volume       = {386},
  number       = {22},
  pages        = {2112--2119},
  doi          = {10.1056/NEJMoa2119662},
  pmid         = {35648703},
  url          = {https://www.nejm.org/doi/full/10.1056/NEJMoa2119662},
  note         = {Single-patient case: 16.2e9 autologous T cells transduced with two HLA-C*08:02-restricted G12D-specific TCRs (cloned from the Tran 2016 work) infused into a metastatic PDAC patient. 72\% partial response, ongoing at 6 mo. Again HLA-C*08:02 not A*11:01 — included for completeness of the G12D-TCR clinical record.}
}

@article{Sidney2008BMCImm,
  author       = {Sidney, John and Peters, Bjoern and Frahm, Nicole and Brander, Christian and Sette, Alessandro},
  title        = {{HLA} class {I} supertypes: a revised and updated classification},
  journal      = {BMC Immunology},
  year         = {2008},
  volume       = {9},
  pages        = {1},
  doi          = {10.1186/1471-2172-9-1},
  pmid         = {18211710},
  url          = {https://bmcimmunol.biomedcentral.com/articles/10.1186/1471-2172-9-1},
  note         = {Places HLA-A*11:01 in the A3 supertype, characterised by basic (K/R/H) C-terminal anchor residues at P9. Specifically: A*11:01 prefers K at P9 (the F pocket). P2 is hydrophobic/small-polar (less stringent than P9). This is the upstream reference for the P9 motif used in tools/mhc.py.}
}

@article{Falk1994Immunogen,
  author       = {Falk, Kirsten and R{\"o}tzschke, Olaf and Takiguchi, Masafumi and Grahovac, Branka and Gnau, Volker and Stevanovi{\'c}, Stefan and Jung, G{\"u}nther and Rammensee, Hans-Georg},
  title        = {Peptide motifs of {HLA}-{A1}, -{A11}, -{A31}, and -{A33} molecules},
  journal      = {Immunogenetics},
  year         = {1994},
  volume       = {40},
  number       = {3},
  pages        = {238--241},
  doi          = {10.1007/BF00167086},
  pmid         = {8039832},
  url          = {https://link.springer.com/10.1007/BF00167086},
  note         = {Pool-sequenced HLA-A*11:01 self-peptides. P2 = hydrophobic or small-polar (T, V, M, L, I, S, A); P9 = K. This is THE original primary motif reference for A*11:01 used in tools/mhc.py.}
}

@article{Zhang1993PNAS,
  author       = {Zhang, Q. J. and Gavioli, R. and Klein, G. and Masucci, M. G.},
  title        = {An {HLA}-{A11}-specific motif in nonamer peptides derived from viral and cellular proteins},
  journal      = {Proceedings of the National Academy of Sciences of the USA},
  year         = {1993},
  volume       = {90},
  number       = {6},
  pages        = {2217--2221},
  doi          = {10.1073/pnas.90.6.2217},
  pmid         = {7681587},
  url          = {https://pmc.ncbi.nlm.nih.gov/articles/PMC46057/},
  note         = {Confirms the A*11:01 nonamer motif: hydrophobic at P2, basic (K) at P9. Used as a cross-check on the Falk 1994 motif. The mhc.py comment block originally cited Hunt et al. 1992 Science 255:1261 by mistake — that paper is about HLA-A2.1, NOT A*11:01. Zhang 1993 is the correct viral/cellular A*11:01 nonamer pool reference.}
}

@article{Pai1990EMBO,
  author       = {Pai, Emil F. and Krengel, Ute and Petsko, Gregory A. and Goody, Roger S. and Kabsch, Wolfgang and Wittinghofer, Alfred},
  title        = {Refined crystal structure of the triphosphate conformation of {H}-ras p21 at 1.35 {\AA} resolution: implications for the mechanism of {GTP} hydrolysis},
  journal      = {EMBO Journal},
  year         = {1990},
  volume       = {9},
  number       = {8},
  pages        = {2351--2359},
  doi          = {10.1002/j.1460-2075.1990.tb07409.x},
  pmid         = {2196171},
  url          = {https://pmc.ncbi.nlm.nih.gov/articles/PMC552258/},
  note         = {1.35 \AA{} crystal of H-ras p21 with GppNp. Establishes the in-line water-attack mechanism with Gln61 and Glu63 as activating species; G12 backbone packs against the gamma-phosphate. This is the structural foundation for "G12 mutants impair GTP hydrolysis".}
}

@article{Krengel1990Cell,
  author       = {Krengel, Ute and Schlichting, Ilme and Scherer, Anna and Schumann, R. and Frech, Matthias and John, J. and Kabsch, Wolfgang and Pai, Emil F. and Wittinghofer, Alfred},
  title        = {Three-dimensional structures of {H}-ras p21 mutants: molecular basis for their inability to function as signal switch molecules},
  journal      = {Cell},
  year         = {1990},
  volume       = {62},
  number       = {3},
  pages        = {539--548},
  doi          = {10.1016/0092-8674(90)90018-A},
  pmid         = {2199064},
  url          = {https://pubmed.ncbi.nlm.nih.gov/2199064/},
  note         = {X-ray structures (2.0--2.6 \AA{}) of H-ras-p21 residues 1--166 for five mutants: G12R, G12V, Q61H, Q61L, D38E. Overall fold preserved; only loop L4 and gamma-phosphate vicinity move. Direct structural evidence that G12 substitutions don't change the global fold of the G-domain, which is the central claim of Step 3 here.}
}

