@article{Zhu2026CommunBiol,
  author       = {Zhu, Jiali and Chen, Zhifeng and Xu, Xi and Wang, Yuxuan and Liu, Pei and Wen, Maorong and Wang, Quanmeng and He, Yuchen and Jin, Hongwei and Xue, Hongjuan and Wang, Shuqing and Xu, Ke and Zhao, Linlin},
  title        = {Structure guided analysis of {KRAS} {G12} mutants in {HLA}-{A}*11:01 reveals a length encoded immunogenic advantage in {G12D}},
  journal      = {Communications Biology},
  year         = {2026},
  volume       = {9},
  pages        = {26},
  doi          = {10.1038/s42003-025-09285-0},
  url          = {https://www.nature.com/articles/s42003-025-09285-0},
  note         = {Important caveat. Combined NMR + X-ray + MD + TCR-binding analysis of HLA-A*11:01 / KRAS G12 peptides. Finds that G12D can be presented as both a 9-mer (VVGADGVGK) and a 10-mer (VVVGADGVGK), but only the 10-mer adopts a stable, immunogenically productive conformation in the A*11:01 groove — the 10-mer forms a more compact, energetically favourable complex (related PDB 7OW4). The motif scorer in tools/mhc.py shortlists the 9-mer based on anchor compatibility only; a structural follow-up at A*11:01 would prefer the 10-mer extension. Flagged in refs/notes.md and logs/06_self_audit.md. (An earlier draft of this entry erroneously listed Alok V. Joglekar as first author; corrected after verifying authorship via the Nature landing page.)}
}
